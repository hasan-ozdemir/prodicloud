# VC-specific settings. Copy this template to <vm-name>.env and fill in the target VM values.
# These values override global DEFAULT_* settings and never belong in clagnos.env.
SELECTED_VM_NAME=<vm-name>
SELECTED_RESOURCE_GROUP=
SELECTED_VM_OS=windows
SELECTED_AZURE_REGION=
VNET_NAME=
SUBNET_NAME=
NSG_NAME=
NSG_RULE_NAME=
PUBLIC_IP_NAME=
NIC_NAME=
VM_DISK_NAME=

VM_STORAGE_SKU=StandardSSD_LRS
VM_SECURITY_TYPE=
VM_ENABLE_HIBERNATION=true
VM_ENABLE_NESTED_VIRTUALIZATION=false
VM_ENABLE_SECURE_BOOT=true
VM_ENABLE_VTPM=true

VM_ADMIN_USER=manager
VM_ADMIN_PASS=<CHANGE_ME_STRONG_ADMIN_PASSWORD>
VM_ASSISTANT_USER=assistant
VM_ASSISTANT_PASS=<CHANGE_ME_STRONG_ASSISTANT_PASSWORD>
VM_SSH_PORT=444
VM_RDP_PORT=3389
TCP_PORTS=80,443,8444,389,5173,3000,3001,8080,5432,3306,6837,4000,4001,5000,5001,5985,6000,6001,6060,7000,7001,7070,8000,8001,9000,9001,9090,2222,3333,4444,5555,6666,7777,8888,9999,11434
PACKAGE_TRANSPORT=ssh

WIN_VM_IMAGE=MicrosoftWindowsDesktop:office-365:win11-25h2-avd-m365:latest
WIN_VM_SIZE=Standard_B4as_v2
WIN_VM_DISK_SIZE_GB=128
LIN_VM_IMAGE=Canonical:ubuntu-24_04-lts:server:latest
LIN_VM_SIZE=Standard_B2as_v2
LIN_VM_DISK_SIZE_GB=40
