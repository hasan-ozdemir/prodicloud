{
  "id": "docker-desktop",
  "displayName": "Docker Desktop",
  "category": "application",
  "timeout": 600,
  "sortOrder": 134,
  "installScript": "install.ps1",
  "statusScript": "status.ps1",
  "updateScript": "update.ps1",
  "uninstallScript": "uninstall.ps1",
  "repairScript": "repair.ps1",
  "updateStrategy": "winget",
  "repairStrategy": "startup",
  "statusCheck": {
    "kind": "winget",
    "value": "Docker.DockerDesktop"
  },
  "uninstall": {
    "kind": "winget",
    "value": "Docker.DockerDesktop"
  },
  "assets": [
    {
      "local": "../../../../tools/scripts/clagnos-interactive-session-helper.ps1",
      "remote": "C:/Windows/Temp/clagnos-interactive-session-helper.ps1"
    }
  ],
  "appStateKey": "134-install-docker-desktop-application",
  "startupPolicy": {
    "roles": [
      "manager",
      "assistant"
    ],
    "userRunEntryName": "Docker Desktop",
    "launchArgument": "--minimized"
  },
  "dependsOn": [
    "windows-subsystem-linux"
  ]
}
