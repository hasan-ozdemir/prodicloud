{
  "id": "windows-package-manager",
  "displayName": "Windows Package Manager",
  "category": "package",
  "timeout": 60,
  "sortOrder": 2,
  "installScript": "install.ps1",
  "statusScript": "status.ps1",
  "updateScript": "update.ps1",
  "uninstallScript": "uninstall.ps1",
  "repairScript": "repair.ps1",
  "updateStrategy": "installer",
  "statusCheck": {
    "kind": "appx",
    "value": "Microsoft.DesktopAppInstaller"
  },
  "uninstall": {
    "kind": "appx",
    "value": "Microsoft.DesktopAppInstaller"
  },
  "operationTimeoutSeconds": {
    "status": 300,
    "install": 60,
    "repair": 60,
    "update": 60,
    "uninstall": 60,
    "reinstall": 120
  },
  "repairStrategy": "installer-verify",
  "uninstallPolicy": {
    "supported": false,
    "reason": "Microsoft.DesktopAppInstaller is a protected Windows system package. Windows rejected per-user AppX removal with 0x80070032; the package must remain installed on this image."
  }
}
