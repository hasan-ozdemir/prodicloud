# clagnos unified clagnos.env template
# Runtime precedence: CLI override > <vm-name>.env value > global clagnos.env default > script default.

# Global active VC pointer and defaults
# ACTIVE_VM_NAME chooses the VC profile used by commands without an explicit VM selector.
# DEFAULT_* values are used only to seed a new VC profile.
DEFAULT_VM_OS=windows
ACTIVE_VM_NAME=
# SELECTED_COMPANY_NAME controls the default Google Chrome profile directory for repo-managed Windows business web shortcuts.
# Repo-managed Chrome profile-directory values are normalized to lowercase.
# Example: SELECTED_COMPANY_NAME=<organization-name> -> --profile-directory="orgprofile"
SELECTED_COMPANY_NAME=
SELECTED_COMPANY_WEB_ADDRESS=<https-url>
SELECTED_COMPANY_EMAIL_ADDRESS=<email>
SELECTED_EMPLOYEE_EMAIL_ADDRESS=<email>
SELECTED_EMPLOYEE_FULL_NAME=<person-name>
# Optional Windows Public Desktop social/web URL overrides.
# Leave blank to keep the generic repo-managed fallback URLs for s1-s18 and i1.
# Business social shortcuts
WIN_PUBLIC_SHORTCUT_SOCIAL_BUSINESS_LINKEDIN_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_BUSINESS_YOUTUBE_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_BUSINESS_GITHUB_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_BUSINESS_TIKTOK_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_BUSINESS_INSTAGRAM_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_BUSINESS_FACEBOOK_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_BUSINESS_X_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_BUSINESS_SNAPCHAT_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_BUSINESS_NEXTSOSYAL_URL=
# Personal social shortcuts
WIN_PUBLIC_SHORTCUT_SOCIAL_PERSONAL_LINKEDIN_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_PERSONAL_YOUTUBE_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_PERSONAL_GITHUB_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_PERSONAL_TIKTOK_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_PERSONAL_INSTAGRAM_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_PERSONAL_FACEBOOK_URL=
WIN_PUBLIC_SHORTCUT_SOCIAL_PERSONAL_X_URL=
# Optional business home/blog shortcut overrides
WIN_PUBLIC_SHORTCUT_WEB_BUSINESS_HOME_URL=
WIN_PUBLIC_SHORTCUT_WEB_BUSINESS_BLOG_URL=
# Optional default Azure subscription id.
# Resolution precedence is: CLI --subscription-id/-s > clagnos.env SELECTED_AZURE_SUBSCRIPTION_ID > active Azure CLI subscription.
# If CLI --subscription-id/-s is provided successfully, clagnos writes that value back into clagnos.env.
SELECTED_AZURE_SUBSCRIPTION_ID=
# Set true to show the persistent two-row TUI status area; false uses the compact legacy header.
TOP_STATUS_LINES=false
DEFAULT_AZURE_REGION=

# Regional naming templates
RESOURCE_GROUP_TEMPLATE=rg-{SELECTED_VM_NAME}-{REGION_CODE}-g{N}
VNET_NAME_TEMPLATE=net-{SELECTED_VM_NAME}-{REGION_CODE}-n{N}
SUBNET_NAME_TEMPLATE=subnet-{SELECTED_VM_NAME}-{REGION_CODE}-n{N}
NSG_NAME_TEMPLATE=nsg-{SELECTED_VM_NAME}-{REGION_CODE}-n{N}
NSG_RULE_NAME_TEMPLATE=nsg-rule-{SELECTED_VM_NAME}-{REGION_CODE}-n{N}
PUBLIC_IP_NAME_TEMPLATE=ip-{SELECTED_VM_NAME}-{REGION_CODE}-n{N}
NIC_NAME_TEMPLATE=nic-{SELECTED_VM_NAME}-{REGION_CODE}-n{N}
VM_DISK_NAME_TEMPLATE=disk-{SELECTED_VM_NAME}-{REGION_CODE}-n{N}

# VM creation defaults; effective settings are saved in each VC profile.
DEFAULT_VM_STORAGE_SKU=StandardSSD_LRS
DEFAULT_VM_SECURITY_TYPE=
# Common feature toggles for create/update post-deploy behavior.
DEFAULT_VM_ENABLE_HIBERNATION=true
DEFAULT_VM_ENABLE_NESTED_VIRTUALIZATION=true
DEFAULT_VM_ENABLE_SECURE_BOOT=true
DEFAULT_VM_ENABLE_VTPM=true
VM_PRICE_COUNT_HOURS=730
# These username defaults seed new VC profiles. Passwords are entered into the new VC profile during interactive create.
# Task-specific literals should stay in the owning task script's top config block.
DEFAULT_VM_ADMIN_USER=manager
DEFAULT_VM_ASSISTANT_USER=assistant
DEFAULT_VM_SSH_PORT=444
DEFAULT_VM_RDP_PORT=3389
AZURE_COMMAND_TIMEOUT_SECONDS=1800
SSH_CONNECT_TIMEOUT_SECONDS=30
SSH_TASK_TIMEOUT_SECONDS=180

# VM properties (platform-specific; required)
DEFAULT_WIN_VM_IMAGE=MicrosoftWindowsDesktop:office-365:win11-25h2-avd-m365:latest
DEFAULT_WIN_VM_SIZE=Standard_B4as_v2
DEFAULT_WIN_VM_DISK_SIZE_GB=128
DEFAULT_LIN_VM_IMAGE=Canonical:ubuntu-24_04-lts:server:latest
DEFAULT_LIN_VM_SIZE=Standard_B2as_v2
DEFAULT_LIN_VM_DISK_SIZE_GB=40

# Task catalogs (relative to repo root or absolute)
WIN_VM_INIT_TASK_DIR=vm-init/windows
WIN_VM_UPDATE_TASK_DIR=vm-update/windows
LIN_VM_INIT_TASK_DIR=vm-init/linux
LIN_VM_UPDATE_TASK_DIR=vm-update/linux

# Task outcome handling: continue | strict
# continue: log task failure and continue with the next task.
# strict: stop the current task stage on the first failure.
VM_TASK_OUTCOME_MODE=continue

# SSH transport
# Windows package operations use the selected PowerShell transport without silent fallback.
# PACKAGE_TRANSPORT accepts: ssh | winrm. WinRM package operations require enabled WinRM and manager credentials.
DEFAULT_PACKAGE_TRANSPORT=ssh
# Linux uses this value directly.
# Windows update flow is forced to single-attempt (1).
SSH_MAX_RETRIES=3
# Repo-relative path is resolved from the repository root when the value is not absolute.
PYSSH_CLIENT_PATH=tools/pyssh/ssh_client.py

# NSG + OS inbound TCP ports (comma-separated, extra ports only)
# VM_SSH_PORT and VM_RDP_PORT are merged automatically. Keep 5985 in TCP_PORTS when Windows PowerShell remoting is needed.
DEFAULT_TCP_PORTS=80,443,8444,389,5173,3000,3001,8080,5432,3306,6837,4000,4001,5000,5001,5985,6000,6001,6060,7000,7001,7070,8000,8001,9000,9001,9090,2222,3333,4444,5555,6666,7777,8888,9999,11434
# Optional allow-listed task/package selection overrides. Blank means all enabled catalog entries.
# VM_INIT_TASKS and VM_UPDATE_TASKS accept comma-separated task ids or numbers; `none` selects none.
# VM_PACKAGE_SETUP_PACKAGES accepts comma-separated `builtin:<id>` / `custom:<id>` entries; `none` selects none.
VM_INIT_TASKS=
VM_UPDATE_TASKS=
VM_PACKAGE_SETUP_PACKAGES=
# Windows language policy defaults. Turkish is installed as an additional selectable language while English remains the default.
WIN_DEFAULT_UI_LANGUAGE=en-US
WIN_ADDITIONAL_LANGUAGES=tr-TR
