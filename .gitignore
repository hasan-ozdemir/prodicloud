# Ignore sensitive runtime environment files
*.env

# Ignore logs and transcripts
.logs/
*.log
*.tmp
prodicloud-log-*.txt
prodicloud-win-e2e-*.log
_tmp_test.txt

# Ignore temp runtime artifacts
.tmp/
tmp/
tmp-logs/
/dist/
.remove-*.state.json*

# Keep task-local app-state captures and restore backups out of the shared task catalog.
vm-init/**/app-state/**
vm-update/**/app-state/**
vm-init/**/backup-app-states/**
vm-update/**/backup-app-states/**
vm-packages/builtin/**/backup-app-states/**
vm-packages/custom/**/backup-app-states/**

# Ignore downloaded SSH helper binaries/vendors
tools/putty/*.exe
tools/winscp/*.exe
tools/pyssh/vendor/
tools/pyssh/.venv/
tools/pyssh/__pycache__/
tools/pyssh/*.pyc

# Legacy folders removed from active architecture
co-vm/
lin-vm/
win-vm/

# OS/editor noise
Thumbs.db
.DS_Store
